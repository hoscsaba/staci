[TITLE]
EPANET TCV import and controls regression test

[JUNCTIONS]
;ID  Elevation  Demand
J1   0          1

[RESERVOIRS]
;ID  Head
R1   30

[VALVES]
;ID     Node1  Node2  Diameter  Type  Setting  MinorLoss
TCV1    R1     J1     20        TCV   2        0.5

[CONTROLS]
LINK TCV1 8 AT TIME 1:00
LINK TCV1 OPEN AT TIME 2:00
LINK TCV1 ACTIVE AT TIME 3:00

[TIMES]
Duration             3:00
Hydraulic Timestep   1:00
Pattern Timestep     1:00
Report Timestep      1:00

[OPTIONS]
Units       LPS
Headloss    H-W
Trials      100
Accuracy    0.001

[END]
